# Copy this to .env after reviewing the image digest and architecture.
# Find the digest on the dedicated amd64 (RackNerd) or arm64 (Oracle) host using:
# docker pull redroid/redroid:14.0.0_64only-latest
# docker image inspect redroid/redroid:14.0.0_64only-latest --format '{{json .RepoDigests}}'
# docker image inspect redroid/redroid:14.0.0_64only-latest --format '{{.Architecture}}'
# Use the reviewed immutable redroid/redroid@sha256:... reference.
REDROID_IMAGE=redroid/redroid@sha256:REPLACE_WITH_REVIEWED_64_HEX_DIGEST
